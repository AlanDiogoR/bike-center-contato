# URL canônica do site (Open Graph / compartilhamento). No Netlify: Site settings → Environment variables.
NEXT_PUBLIC_SITE_URL=https://contatobikecenter.netlify.app

# Google Tag Manager (opcional) — ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta Pixel (opcional)
NEXT_PUBLIC_FB_PIXEL_ID=

# Link da loja no Mercado Livre (opcional). Cole aqui o URL completo copiado do painel do vendedor se o padrão do site falhar.
# NEXT_PUBLIC_MERCADO_LIVRE_URL=

# Slot opcional de oferta/destaque no topo (ambos precisam estar preenchidos). Vazio = oculto.
# NEXT_PUBLIC_HIGHLIGHT_LABEL=
# NEXT_PUBLIC_HIGHLIGHT_HREF=

# Formulário VIP (padrão desligado; só ativa com VIP_ENABLED=true e exige redeploy).
# O client não fala diretamente com o Supabase (NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY foram removidas);
# o envio passa exclusivamente pela Netlify Function /api/vip no servidor.
# VIP_ENABLED=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# SUPABASE_URL=
# Chave service_role do Supabase (somente servidor; nunca NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
# VIP_RATE_SALT=
# VIP_ALLOWED_HOSTS=
