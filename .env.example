# URL canônica do site (Open Graph / compartilhamento). No Netlify: Site settings → Environment variables.
NEXT_PUBLIC_SITE_URL=https://seudominio.netlify.app

# Google Tag Manager (opcional) — ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta Pixel (opcional)
NEXT_PUBLIC_FB_PIXEL_ID=

# Link da loja no Mercado Livre (opcional). Cole aqui o URL completo copiado do painel do vendedor se o padrão do site falhar.
# NEXT_PUBLIC_MERCADO_LIVRE_URL=
